local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Status Config
local heightOffset = 1.2
local crownScale = 1.0
local crownActive = true
local headlessActive = true
local isMinimized = false

-- Asset ID Original 8-Bit Royal Crown
local CROWN_MESH = "rbxassetid://10159599525"
local CROWN_TEX  = "rbxassetid://10159596328"

-- Safe Parent GUI Generator
local function getSafeParentGui()
    if gethui then return gethui() end
    local success, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if success and coreGui then return coreGui end
    return LocalPlayer:WaitForChild("PlayerGui", 5)
end

-- Membuat Part Mahkota di Workspace (Bypass Sistem Hapus Evade)
local crownPart = workspace:FindFirstChild("EvadeRoyalCrownPart")
if crownPart then crownPart:Destroy() end

crownPart = Instance.new("Part")
crownPart.Name = "EvadeRoyalCrownPart"
crownPart.Size = Vector3.new(1, 1, 1)
crownPart.CanCollide = false
crownPart.CastShadow = false
crownPart.Massless = true
crownPart.Anchored = true
crownPart.Transparency = 1

local crownMesh = Instance.new("SpecialMesh")
crownMesh.Name = "CrownMesh"
crownMesh.MeshType = Enum.MeshType.FileMesh
crownMesh.MeshId = CROWN_MESH
crownMesh.TextureId = CROWN_TEX
crownMesh.Scale = Vector3.new(crownScale, crownScale, crownScale)
crownMesh.Parent = crownPart

crownPart.Parent = workspace

-- Connection variable
local renderConnection

-- RenderStepped Loop (Update Posisi & Visual setiap frame)
renderConnection = RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local head = char and char:FindFirstChild("Head")

    -- 1. HEADLESS EXECUTION (Khusus Evade Engine)
    if char and head then
        if headlessActive then
            head.Transparency = 1
            head.LocalTransparencyModifier = 1 -- Memaksa transparansi menembus sistem kamera Evade
            
            for _, v in pairs(head:GetChildren()) do
                if v:IsA("Decal") then
                    v.Transparency = 1
                elseif v:IsA("SpecialMesh") then
                    v.Scale = Vector3.zero
                end
            end
        else
            head.Transparency = 0
            head.LocalTransparencyModifier = 0
            for _, v in pairs(head:GetChildren()) do
                if v:IsA("Decal") then
                    v.Transparency = 0
                elseif v:IsA("SpecialMesh") then
                    v.Scale = Vector3.new(1, 1, 1)
                end
            end
        end
    end

    -- 2. 8-BIT ROYAL CROWN EXECUTION
    if crownActive and char and head and head:IsDescendantOf(workspace) then
        crownPart.Parent = workspace
        crownPart.Transparency = 0
        crownPart.LocalTransparencyModifier = 0
        crownMesh.Scale = Vector3.new(crownScale, crownScale, crownScale)
        
        -- Kunci posisi Mahkota tepat di atas CFrame Kepala
        crownPart.CFrame = head.CFrame * CFrame.new(0, heightOffset, 0)
    else
        crownPart.Transparency = 1
    end
end)

-- Helper GUI UICorner
local function createCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 6)
    corner.Parent = parent
    return corner
end

-- Generator GUI Menu Utama
